{
	"name": "gc-articles-infrastructure",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm@sha256:3aacff4130e6cf04709f9cab1d7a6d3e1cc4bff6202bc61611831a18d3755673",
	"containerEnv": {
		"SHELL": "/bin/zsh"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"[terraform]": {
					"editor.formatOnSave": true
				}
			},
			"extensions": [
				"hashicorp.terraform",
				"redhat.vscode-yaml",
				"github.copilot"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/aws-cli:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/terraform:1": {
			"version": "1.16.2",
			"terragrunt": "1.0.4"
		}
	},
	"remoteUser": "vscode"
}